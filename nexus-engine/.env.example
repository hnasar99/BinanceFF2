# NEXUS runs in SHADOW_NO_BROADCAST mode. No signing key is accepted by v1.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8788

# Semicolon-separated EVM chain WebSocket endpoints.
# Use your own provider credentials. Examples are placeholders only.
NEXUS_CHAINS=bnb=wss://YOUR_BNB_WS;base=wss://YOUR_BASE_WS

# Deterministic shadow risk gate.
NEXUS_MIN_NET_PROFIT_USD=10
NEXUS_MIN_CONFIDENCE=0.80

RUST_LOG=nexus_engine=info,info
